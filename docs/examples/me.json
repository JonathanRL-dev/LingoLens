{
  "request": {
    "method": "GET",
    "path": "/api/v1/me",
    "headers": {
      "Authorization": "Bearer example-jwt-not-a-real-token"
    }
  },
  "responses": {
    "200": {
      "success": true,
      "data": {
        "id": "u-demo",
        "nickname": "Bintang",
        "level": 1,
        "totalXp": 20,
        "xpInLevel": 20,
        "xpForNextLevel": 100,
        "streak": 0,
        "collectedCount": 0
      }
    },
    "401": {
      "success": false,
      "error": {
        "code": "UNAUTHORIZED",
        "message": "Token autentikasi tidak sah.",
        "details": null
      }
    }
  }
}
