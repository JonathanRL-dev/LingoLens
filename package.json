{
  "name": "lingolens",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "engines": {
    "node": ">=20 <23"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:client": "npm run dev -w @lingolens/client",
    "dev:server": "npm run dev -w @lingolens/server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "test": "vitest run",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "eslint": "^9.39.0",
    "@eslint/js": "^9.39.0",
    "typescript-eslint": "^8.46.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "vitest": "^4.1.11",
    "@types/node": "^22.18.0"
  }
}
