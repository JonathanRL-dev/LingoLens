# Koneksi MySQL untuk pengembangan lokal, sesuai docker-compose.yml.
DATABASE_URL="mysql://lingolens:lingolens_dev@localhost:3306/lingolens"
# Ganti dengan secret acak minimal 32 karakter sebelum digunakan.
JWT_SECRET=ganti-dengan-string-acak-min-32-karakter
# Origin client yang diizinkan mengakses API.
CORS_ORIGIN=http://localhost:5173
# Port HTTP server lokal.
PORT=4000
# Mode pengembangan lokal.
NODE_ENV=development
# Ganti dengan kunci khusus untuk reset data demo.
DEMO_RESET_KEY=ganti-dengan-kunci-reset-demo
