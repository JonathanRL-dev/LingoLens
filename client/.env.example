# URL API server untuk pengembangan lokal.
VITE_API_URL=http://localhost:4000
# Default aman: gunakan API asli agar integrasi dapat diverifikasi.
VITE_USE_MOCK=false
# Default aman: mode demo dinonaktifkan agar alur demo tidak aktif otomatis.
VITE_DEMO_MODE=false
# Default: fitur koleksi tersedia untuk pengembangan.
VITE_ENABLE_COLLECTION=true
# Default: fitur profil tersedia untuk pengembangan.
VITE_ENABLE_PROFILE=true
